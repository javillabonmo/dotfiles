{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin-macchiato",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/{env:USER}"
      ]
    },
    "git-local": {
      "type": "local",
      "command": ["bunx", "-y", "@modelcontextprotocol/server-git"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://{env:POSTGRES_USER}:{env:POSTGRES_PASSWORD}@localhost:5432/{env:POSTGRES_DB}",
        "--readOnly"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"]
    },
    "obsidian": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@bitbonsai/mcpvault@latest",
        "{env:OBSIDIAN_VAULT}"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "MongoDB": {
      "type": "local",
      "command": ["bunx", "-y", "mongodb-mcp-server@latest", "--readOnly"],
      "enabled": false,
      "environment": {
        "MDB_MCP_CONNECTION_STRING": "{env:MONGODB_CONNECTION_STRING}"
      }
    },
    "kubernetes": {
      "type": "local",
      "command": ["bunx", "-y", "kubernetes-mcp-server@latest", "--readOnly"],
      "enabled": false
    }
  }
}
